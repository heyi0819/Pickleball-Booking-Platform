# Runtime profile
SPRING_PROFILES_ACTIVE=local

# PostgreSQL (local Compose defaults)
DATABASE_URL=jdbc:postgresql://localhost:5432/pickleball_booking
DATABASE_USERNAME=pickleball
DATABASE_PASSWORD=change-me-for-local-use

# JWT validation contract (placeholders only; no credentials)
JWT_ISSUER=https://issuer.example.com
JWT_AUDIENCE=pickleball-booking-platform

# LINE / LIFF identifiers (placeholders only; no credentials)
LINE_CHANNEL_ID=your-line-channel-id
LINE_CHANNEL_SECRET=replace-with-local-secret
LIFF_ID=your-liff-id

# Browser API base URL
VITE_API_BASE_URL=http://localhost:8080/api/v1
