# Runtime profile
SPRING_PROFILES_ACTIVE=local

# PostgreSQL (local Compose defaults)
DATABASE_URL=jdbc:postgresql://localhost:5432/pickleball_booking
DATABASE_USERNAME=pickleball
DATABASE_PASSWORD=change-me-for-local-use

# Backend-issued platform JWT signing material (inject a secret in production)
JWT_SIGNING_SECRET=replace-with-at-least-32-character-local-secret

# LINE / LIFF identifiers and Messaging API placeholder (no real credentials)
LINE_LOGIN_CHANNEL_ID=your-line-channel-id
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=your-line-messaging-channel-access-token
LINE_MESSAGING_TIMEOUT_MILLIS=3000
VITE_LIFF_ID=your-liff-id

# Worker runtime. Daily coach reminder defaults to 18:00 Asia/Taipei for next-day sessions.
WORKERS_ENABLED=false
OUTBOX_WORKER_DELAY_MS=5000
NOTIFICATION_WORKER_DELAY_MS=5000
COACH_REMINDER_CRON=0 0 18 * * *
COACH_REMINDER_ZONE=Asia/Taipei

# Browser API base URL
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Browser origins accepted by backend CORS. Keep empty for local same-origin/default-deny.
# Staging example: https://pickleball-stg-liff.pages.dev,https://pickleball-stg-admin.pages.dev
APP_CORS_ALLOWED_ORIGINS=

# Public age recipient used by the S10.2 staging backup procedure. The private identity stays outside Git.
STAGING_BACKUP_AGE_RECIPIENT=age1yp7p697sexzjzupzkrsvjng5th3kg9e60e732whl3kza8svw4g4sv3d7vz
